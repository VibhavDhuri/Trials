# Upstox API Credentials
# Get these from: https://developer.upstox.com/
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5555/callback

# Paste your access token here after completing OAuth2 login
# Token is valid until midnight IST — refresh daily
UPSTOX_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# LIVE ORDER PLACEMENT — DISABLED BY DEFAULT
# WARNING: Setting this to 'true' will send REAL orders to your Upstox account.
#          Only enable when you have tested thoroughly in paper mode and fully
#          understand the risk. Options trading involves significant risk of loss.
# When false (default): orders are simulated as paper trades in PositionTracker.
# ─────────────────────────────────────────────────────────────────────────────
UPSTOX_ENABLE_TRADING=false

# ─────────────────────────────────────────────────────────────────────────────
# ALERT NOTIFICATIONS — EMAIL (optional)
# Uses STARTTLS SMTP. For Gmail: enable 2FA and create an App Password.
# Leave blank to disable email alerts.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─────────────────────────────────────────────────────────────────────────────
# ALERT NOTIFICATIONS — TELEGRAM (optional)
# 1. Create a bot via @BotFather → copy the token
# 2. Send /start to your bot
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat.id
# Leave blank to disable Telegram alerts.
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# UPSTOX PLUS — expired options historical data (optional)
# Requires an Upstox Plus subscription.
# When true: enables get_expired_instrument_candles() for backtesting
# expired option strikes directly via Upstox API.
# ─────────────────────────────────────────────────────────────────────────────
UPSTOX_PLUS=false

# ─────────────────────────────────────────────────────────────────────────────
# BREEZE API — ICICI Direct historical options data (optional)
# Free for ICICI Direct account holders. Gives per-strike OHLCV + OI,
# up to 3 years of history at 1-minute granularity.
# Setup: pip install breeze-connect
# Get credentials at: https://api.icicidirect.com
# 1. Login to ICICI Direct → Developer Console → Create App
# 2. Add BREEZE_API_KEY and BREEZE_API_SECRET below
# 3. Each day, generate a session token via the Breeze login URL and paste below
# ─────────────────────────────────────────────────────────────────────────────
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
